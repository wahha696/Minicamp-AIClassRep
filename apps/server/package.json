{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "verify:accounts": "node --experimental-strip-types --import ./verify/hooks.mjs verify/verify-accounts.ts",
    "eval:accuracy": "tsx src/pipeline/accuracy-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "cheerio": "^1.0.0",
    "domhandler": "^5.0.3",
    "hono": "^4.9.0",
    "iconv-lite": "^0.6.3",
    "openai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
