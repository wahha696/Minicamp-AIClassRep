{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classrep.local/schemas/fastjudge-holdout-v2.json",
  "title": "ClassRepFastJudgeHoldoutV2",
  "description": "Holdout for Jev vs local comparison. Same core fields as sample.schema.json; source may include holdout tags.",
  "type": "object",
  "required": [
    "id",
    "group_name",
    "context",
    "message",
    "label",
    "source"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "group_name": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "sender_name",
          "text"
        ],
        "properties": {
          "sender_name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "message": {
      "type": "object",
      "required": [
        "sender_name",
        "text"
      ],
      "properties": {
        "sender_name": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "label": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "soft_label": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
