{
  "name": "classrep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "pack:win": "node scripts/pack.mjs",
    "start": "node scripts/bootstrap.mjs",
    "dev:start": "node scripts/dev.mjs",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "train:build": "node node_modules/typescript/bin/tsc -p train/tsconfig.json",
    "train:gen:jev": "node train/dist/train/gen-jev-data.js",
    "train:gen:scenarios": "node train/dist/train/gen-scenarios.js",
    "train:gen:sft": "node train/dist/train/gen-sft-data.js",
    "train:smoke": "node train/dist/train/smoke-prompts.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openai": "^6.0.0",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  }
}
