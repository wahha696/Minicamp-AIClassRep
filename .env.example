# 复制成 .env（开发时放仓库根，打包后放 app/.env），填上自己的 key。
# 这些变量只有后端读，前端零密钥。

# LLM（OpenAI 兼容协议）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Jev 快判：填写 TypeSafe API Key 后启用；请求失败时继续走上面的 LLM
ENABLE_JEV=true
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=3000

# 演示模式：true 才允许 POST /api/demo/reset
DEMO_MODE=true

# 原始消息保留天数（到期由清理任务删除；事件来源是快照，不受影响）
RAW_MSG_TTL_DAYS=7

# OneBot WebSocket 地址（四问题修复 #4）：默认本机注入的 NapCat；Docker/远程 NapCat 时改这里
# ONEBOT_WS_URL=ws://127.0.0.1:3001

# 组件下载镜像（nodejs.org / GitHub 直连慢或被墙时；也可用系统环境变量设置）
# NODE_MIRROR=https://npmmirror.com/mirrors/node
# NAPCAT_MIRROR=https://ghfast.top/https://github.com
