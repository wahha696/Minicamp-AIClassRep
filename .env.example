# 复制成 .env（开发时放仓库根，打包后放 app/.env），填上自己的 key。
# 这些变量只有后端读，前端零密钥。

# LLM（OpenAI 兼容协议）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Jev 快判：填写 TypeSafe API Key 后启用；请求失败时继续走上面的 LLM
ENABLE_JEV=true
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=3000

# 本地快判（classrep-fastjudge）：jev | local | dual
# 产品决策（2026-09-29）：默认只用本地，简单省事。dual 仅调试对照时开。
# dual 时两边都打分，路由用 FASTJUDGE_ROUTE（jev|local）
FASTJUDGE_MODE=local
FASTJUDGE_ROUTE=local
# 零配置约定：把 classrep-fastjudge 目录放到项目根（含 src/infer.py）即自动启用，
# 此时以下三项都可留空。工作区在别处才需要显式指 FASTJUDGE_ROOT。
# 例（Windows）：
#   FASTJUDGE_ROOT=D:\dev\classrep-fastjudge
#   LOCAL_JEV_MODEL_PATH=D:\dev\classrep-fastjudge\models\local-jev-v1.joblib
#   FASTJUDGE_PYTHON=D:\dev\classrep-fastjudge\.venv\Scripts\python.exe
# 例（Linux/macOS 开发机）：
#   FASTJUDGE_ROOT=/path/to/classrep-fastjudge
#   LOCAL_JEV_MODEL_PATH=/path/to/classrep-fastjudge/models/local-jev-v1.joblib
#   FASTJUDGE_PYTHON=/path/to/classrep-fastjudge/.venv/bin/python
# 若只设 FASTJUDGE_ROOT，模型默认取 ROOT/models/local-jev-v1.joblib；
# FASTJUDGE_PYTHON 空时依次探测 ROOT/py/python.exe（便携）→ .venv（Win: Scripts/python.exe）→ 系统 python。
LOCAL_JEV_MODEL_PATH=
FASTJUDGE_ROOT=
FASTJUDGE_PYTHON=

# 演示模式：true 才允许 POST /api/demo/reset
DEMO_MODE=true

# 原始消息保留天数（到期由清理任务删除；事件来源是快照，不受影响）
RAW_MSG_TTL_DAYS=7

# 本地 Scene Extractor（classrep-extractor / v4-DFG）：cloud | local
# 默认 cloud（走上面的 LLM）。local 时由常驻 infer_serve.py 提取；prompt/postprocess 在 Python 侧。
# EXTRACT_MODE=local
# EXTRACTOR_ROOT=E:\AIModels\classrep-extractor
# EXTRACTOR_PYTHON=E:\AIModels\classrep-extractor\env\Scripts\python.exe
# EXTRACT_ADAPTER=E:\AIModels\classrep-extractor\runs\qwen3-1.7b-qlora-v4-time
# EXTRACT_BASE=unsloth/Qwen3-1.7B-bnb-4bit
# EXTRACT_TIMEOUT_MS=120000

# OneBot WebSocket 地址（四问题修复 #4）：默认本机注入的 NapCat；Docker/远程 NapCat 时改这里
# ONEBOT_WS_URL=ws://127.0.0.1:3001

# 组件下载镜像（nodejs.org / GitHub 直连慢或被墙时；也可用系统环境变量设置）
# NODE_MIRROR=https://npmmirror.com/mirrors/node
# NAPCAT_MIRROR=https://ghfast.top/https://github.com
