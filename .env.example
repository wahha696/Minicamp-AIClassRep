# 复制成 .env（开发时放仓库根，打包后放 app/.env），填上自己的 key。
# 这些变量只有后端读，前端零密钥。

# LLM（OpenAI 兼容协议）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Jev 快判：填写 TypeSafe API Key 后启用；请求失败时继续走上面的 LLM
ENABLE_JEV=true
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=3000

# 演示模式：true 才允许 POST /api/demo/reset
DEMO_MODE=true

# 原始消息保留天数（到期由清理任务删除；事件来源是快照，不受影响）
RAW_MSG_TTL_DAYS=7
