# Training workspace (local model training). Patterns are RELATIVE to train/,
# because this .gitignore lives inside train/. Do NOT prefix with "train/".
# Local environment / heavy artifacts (never commit)
data/
models/
artifacts/
**/*.log
**/__pycache__/
*.pyc

# Python virtualenvs and deps installed with --target
.venv/
.venv*/
venv/
pylibs/
pylibs-gpu/

# pip/HF caches
.cache/

# llama.cpp checkout (GGUF conversion tooling, cloned on demand)
llama.cpp/

# build output
dist/

# NOTE: train/env/ holds SOURCE (serve_hf.py, setup_windows.ps1, smoke_gpu.py,
# llama-server.ps1) and must stay tracked - do not add an "env/" rule here.

# 量化工具：根 .gitignore 的 tools/ 会把这里一起忽略，显式放行
!tools/
