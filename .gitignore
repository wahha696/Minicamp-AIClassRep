# 采集端 NapCat 4.18.28（程序随仓库提交，克隆即可用；见 napcat/README.md）。
# 只忽略账号数据、运行时生成的文件和非 Windows x64 的原生库。
# 开头的 / 只作用于仓库根的 napcat/，不会误伤 apps/server/src/napcat/ 源码目录
# 注意：napcat/node_modules 下的 dist/ 目录必须完整随仓库（qs/dist/qs.js 等是运行必需），
# 顶部的裸 dist/ 规则会把它们静默吞掉，所以这里用 ** 整树反忽略
!/napcat/node_modules/
!/napcat/node_modules/**
/napcat/config/
/napcat/cache/
/napcat/logs/
/napcat/plugins/
/napcat/guild*.db*
/napcat/*.db
/napcat/*.db-*
/napcat/_loader_debug.log
/napcat/loadNapCat.js
/napcat/*.bat
/napcat/native/**/*linux*
/napcat/native/**/*darwin*
/napcat/native/**/*arm64*

# 运行时数据（只保留仿真剧本 data/mock/）
data/*
!data/mock/
# 从 apps/server 工作目录单独跑测试时可能生成的诊断页
/apps/server/data/

# 打包产物与私密配置
release/
.env.release

# 启动.bat 自动下载的便携版 Node（每台机器各自下载）
/runtime/
/runtime.download/

# corepack 下载的 pnpm（本机缓存）与 pnpm 包仓库缓存
.corepack/
.pnpm-store/
.pnpm-dist/
*.tsbuildinfo

# 本地 AI 工具的技能文件与生成的架构图（不进仓库）
.agents/

# 本地快判工作区：源码 + 模型（models/*.joblib，约 5MB）随仓库分发，克隆即用；
# 只忽略 Python 运行时与缓存（.venv 是机器绝对路径；py/ 由 fastjudge-setup.mjs 供给，release 时打进 zip）
/classrep-fastjudge/.venv/
/classrep-fastjudge/py/
classrep-fastjudge/**/__pycache__/
classrep-fastjudge/**/*.cache
/classrep-fastjudge/models/best/
# 训练数据与评测报告（可能含未脱敏样本）：不进仓库、不进发布包（R3）
/classrep-fastjudge/data/
/classrep-fastjudge/reports/
skills-lock.json
docs/architecture/

# 本机测试与训练产物，不属于产品交付
/apps/server/data/
/unsloth_compiled_cache/
/response_only_train.py
**/__pycache__/
